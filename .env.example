# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "production" permite indexar en buscadores. Cualquier otro valor → noindex.
NEXT_PUBLIC_SITE_ENV=development

# "true" hace fallar el build si alguna página o los parámetros clínicos no están revisados.
# Activar en producción antes del lanzamiento (roadmap, fase 3).
REQUIRE_CLINICAL_REVIEW=false
