{
  "name": "ortoguia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "velite build --strict && next dev",
    "build": "velite build --clean --strict && next build",
    "start": "next start",
    "content": "velite build --strict",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "velite build --strict && next typegen && tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "^0.4.0"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  }
}
